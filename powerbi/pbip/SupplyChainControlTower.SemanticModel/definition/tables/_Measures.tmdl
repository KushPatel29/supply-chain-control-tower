	measure 'KPI SVG Value Expiring In Window | Expiry Window Reference' =
			VAR vValue = [Value Expiring In Window]
			VAR vShown = IF(ISBLANK(vValue), "—", IF(ABS(vValue) >= 1000000, FORMAT(vValue / 1000000, "$#,0.00") & "M", FORMAT(vValue, "\$#,0")))
			VAR vCaptionRaw = SUBSTITUTE(SUBSTITUTE(COALESCE([Expiry Window Reference], ""), "&", "&amp;"), "<", "&lt;")
			VAR vCaption = IF(LEN(vCaptionRaw) > 58, LEFT(vCaptionRaw, 56) & "…", vCaptionRaw)
			VAR vAccent = "#8B8BFF"
			VAR vValueFill = "#FFFFFF"
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='296' height='112' viewBox='0 0 296 112'>"
			        & "<rect x='0' y='18' width='3' height='76' rx='1.5' fill='" & vAccent & "'/>"
			        & "<text x='16' y='28' font-family='Segoe UI' font-size='11' fill='#A6ABD1'>Value Expiring In Window</text>"
			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='" & vValueFill & "'>" & vShown & "</text>"
			        & ""
			        & "<text x='16' y='90' font-family='Segoe UI' font-size='10' fill='#8B90B8'>" & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 6c3c04ad-2d61-582d-aca9-f50cb91605de
		dataCategory: ImageUrl
		displayFolder: Report UI

	measure 'KPI SVG Lots Expiring In Window | Lots Expiring Reference' =
			VAR vValue = [Lots Expiring In Window]
			VAR vShown = IF(ISBLANK(vValue), "—", IF(ABS(vValue) >= 1000000, FORMAT(vValue / 1000000, "#,0.00") & "M", FORMAT(vValue, "#,0")))
			VAR vCaptionRaw = SUBSTITUTE(SUBSTITUTE(COALESCE([Lots Expiring Reference], ""), "&", "&amp;"), "<", "&lt;")
			VAR vCaption = IF(LEN(vCaptionRaw) > 58, LEFT(vCaptionRaw, 56) & "…", vCaptionRaw)
			VAR vAccent = "#8B8BFF"
			VAR vValueFill = "#FFFFFF"
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='296' height='112' viewBox='0 0 296 112'>"
			        & "<rect x='0' y='18' width='3' height='76' rx='1.5' fill='" & vAccent & "'/>"
			        & "<text x='16' y='28' font-family='Segoe UI' font-size='11' fill='#A6ABD1'>Lots Expiring In Window</text>"
			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='" & vValueFill & "'>" & vShown & "</text>"
			        & ""
			        & "<text x='16' y='90' font-family='Segoe UI' font-size='10' fill='#8B90B8'>" & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 004bc243-b457-5202-a045-13f8ee77ce51
		dataCategory: ImageUrl
		displayFolder: Report UI

	measure 'KPI SVG Weighted Days To Expiry | Shelf Life Reference' =
			VAR vValue = [Weighted Days To Expiry]
			VAR vShown = IF(ISBLANK(vValue), "—", IF(ABS(vValue) >= 1000000, FORMAT(vValue / 1000000, "#,0.00") & "M", FORMAT(vValue, "0.0")))
			VAR vCaptionRaw = SUBSTITUTE(SUBSTITUTE(COALESCE([Shelf Life Reference], ""), "&", "&amp;"), "<", "&lt;")
			VAR vCaption = IF(LEN(vCaptionRaw) > 58, LEFT(vCaptionRaw, 56) & "…", vCaptionRaw)
			VAR vAccent = "#8B8BFF"
			VAR vValueFill = "#FFFFFF"
			VAR vSvg =
			    "<svg xmlns='http://www.w3.org/2000/svg' width='296' height='112' viewBox='0 0 296 112'>"
			        & "<rect x='0' y='18' width='3' height='76' rx='1.5' fill='" & vAccent & "'/>"
			        & "<text x='16' y='28' font-family='Segoe UI' font-size='11' fill='#A6ABD1'>Weighted Days To Expiry</text>"
			        & "<text x='16' y='64' font-family='Segoe UI Light' font-size='30' fill='" & vValueFill & "'>" & vShown & "</text>"
			        & ""
			        & "<text x='16' y='90' font-family='Segoe UI' font-size='10' fill='#8B90B8'>" & vCaption & "</text>"
			        & "</svg>"
			RETURN
			    "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(vSvg, "%", "%25"), "#", "%23")
		lineageTag: 295e87e5-4522-5afa-ab08-ae7dfd8a3ca1
		dataCategory: ImageUrl
		displayFolder: Report UI

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5608e50b-58b0-4c92-b17b-c7eb8f62f3b6
		summarizeBy: none
		sourceColumn: Value

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Value = Int64.Type], {})
				in
				    Source

	/// What was invoiced across every purchase order line in the window.
	measure 'Inbound Spend' = SUM(supplier_scorecard[spend])
		formatString: \$#,0
		lineageTag: 1c5bbf5b-0a12-5bef-ae31-7bbfb6835c29

	/// What the same receipts would have cost at the negotiated price.
	measure 'Contract Spend' = SUM(supplier_scorecard[contract_spend])
		formatString: \$#,0
		lineageTag: 95e42a50-8bff-5ace-8696-d6e874585b95

	/// Invoiced minus contracted. Positive is money leaking out of the deal that was signed.
	measure 'Purchase Price Variance' = [Inbound Spend] - [Contract Spend]
		formatString: \$#,0
		lineageTag: 32c4e2c1-8324-57d8-b418-0fc894ba048e

	/// The same leak as a rate, so a small supplier's discipline is comparable to a large one's.
	measure 'PPV %' = DIVIDE([Purchase Price Variance], [Contract Spend])
		formatString: 0.0%
		lineageTag: 2a6c8108-1122-5687-9098-4724c59c7309

	measure 'Units Received' = SUM(supplier_scorecard[units_received])
		formatString: #,0
		lineageTag: cdd894d2-c487-5639-a5ec-8e03c17456b0

	measure 'Units Rejected' = SUM(supplier_scorecard[units_rejected])
		formatString: #,0
		lineageTag: ca35d86a-9cf7-55d6-8ea3-852f02c82324

	/// On units, not on lines: a 2% rejection on a 5,000-unit receipt matters more than a 40% one on a 200-unit receipt.
	measure 'Reject Rate' = DIVIDE([Units Rejected], [Units Received])
		formatString: 0.00%
		lineageTag: 0ea0bcb2-a39d-59ab-b426-ff51681135d3

	/// Money spent on stock that was condemned at the gate. A cash number, not a ratio.
	measure 'Cost of Poor Quality' = SUM(supplier_scorecard[cost_of_poor_quality])
		formatString: \$#,0
		lineageTag: 0e31204f-a1cf-558e-93ab-d221bbd1efc5

	/// Line-weighted, so the panel total is the rate across all purchase orders rather than the average of fifteen supplier rates - which would let a supplier with 34 lines swing the number as hard as one with 341.
	measure 'Inbound OTIF %' =
			DIVIDE(
			SUMX(supplier_scorecard, supplier_scorecard[po_lines] * supplier_scorecard[otif_rate]),
			SUM(supplier_scorecard[po_lines])
			)
		formatString: 0.0%
		lineageTag: ba40f84a-fa5d-5125-8ce1-a67d261103fd

	measure 'Inbound On Time %' =
			DIVIDE(
			SUMX(supplier_scorecard, supplier_scorecard[po_lines] * supplier_scorecard[on_time_rate]),
			SUM(supplier_scorecard[po_lines])
			)
		formatString: 0.0%
		lineageTag: 35a19250-2003-5b3a-af15-c8c3fd6d7a0c

	/// Measured on the ACCEPTED quantity: a receipt that arrived complete and was then condemned did not fill the order.
	measure 'Inbound In Full %' =
			DIVIDE(
			SUMX(supplier_scorecard, supplier_scorecard[po_lines] * supplier_scorecard[in_full_rate]),
			SUM(supplier_scorecard[po_lines])
			)
		formatString: 0.0%
		lineageTag: 4b672756-5e64-53c7-811d-038c84b56656

	/// Delivery 35, quality 30, cost 20, responsiveness 15 - scored against published targets, never against the rest of the panel.
	measure 'Composite Score' = AVERAGE(supplier_scorecard[composite_score])
		formatString: 0.0
		lineageTag: 18ea9231-33ea-5ac7-a869-156f1c1b634d

	measure 'Suppliers Scored' = COUNTROWS(supplier_scorecard)
		formatString: #,0
		lineageTag: 16351fe8-8369-5e40-9ae3-4b6a22918c55

	/// Suppliers whose measured band is not the band their contract calls them. The contractual tier is never an input to the score, so this comparison is not circular.
	measure 'Tier Mismatches' = CALCULATE([Suppliers Scored], supplier_scorecard[tier_matches_measurement] = 0)
		formatString: #,0
		lineageTag: b7001169-a807-51d4-9d60-22a0786c71f5

	measure 'Spend Under Mismatched Tier' = CALCULATE([Inbound Spend], supplier_scorecard[tier_matches_measurement] = 0)
		formatString: \$#,0
		lineageTag: a8999711-e917-5273-8207-e0ea8c0ca862

	/// Colour by measurement, not by rank position: the best supplier on the page is green and anything under 45 is red wherever it sorts.
	measure 'Score Highlight' =
			VAR vTop = CALCULATE(MAX(supplier_scorecard[composite_score]), ALLSELECTED(supplier_scorecard))
			VAR vHere = [Composite Score]
			RETURN IF(vHere = vTop, "#5FD3A6", IF(vHere < 45, "#E0575B", "#7C9CC4"))
		lineageTag: 24fba888-95e4-57dc-938d-e3fa9b6a3f8e

	/// Annual spend sitting with a primary that a qualified alternate out-scores.
	measure 'Spend At Risk' = SUM(award_shift_candidates[spend_at_risk])
		formatString: \$#,0
		lineageTag: f096887b-61d2-5c13-929b-80768d94eecd

	measure 'Award Shift SKUs' = COUNTROWS(award_shift_candidates)
		formatString: #,0
		lineageTag: 60d200a4-6f72-5e60-872b-c227e867fca0

	/// What moving that spend does to the purchase price. Positive costs money. Alternates that have never shipped the SKU carry no price and are excluded rather than guessed at.
	measure 'Price Impact of Shifting' = CALCULATE(SUM(award_shift_candidates[price_impact]), award_shift_candidates[price_known] = 1)
		formatString: \$#,0
		lineageTag: ff5d5e0b-4f32-52b7-aa8e-a5f24826f218

	/// Qualified second sources that have never actually been ordered from for the SKU they are approved on.
	measure 'Unpriced Alternates' = CALCULATE([Award Shift SKUs], award_shift_candidates[price_known] = 0)
		formatString: #,0
		lineageTag: 0a1cae8e-ecee-5c61-b553-c4460579d028

	measure 'Rejected Value' = SUM(reject_reasons[value])
		formatString: \$#,0
		lineageTag: c59d3aa4-930e-59bc-804c-9ac9a98179d2

	measure 'Reject Share' = SUM(reject_reasons[share_of_value])
		formatString: 0.0%
		lineageTag: 026ff7e1-e7b6-5d8d-83fd-e4dbb255fe19

	/// The safety-stock investment a given cycle service level requires across all 478 positions.
	measure 'Safety Stock Value' = SUM(service_exchange_curve[safety_stock_value])
		formatString: \$#,0
		lineageTag: 8c6664ab-47ea-5deb-b57d-88b47c50c703

	measure 'Fill Rate' = SUM(service_exchange_curve[fill_units])
		formatString: 0.00%
		lineageTag: 06f1f02b-b629-53fd-ae07-8b3a9d3e3d58

	/// What each service level costs against the flat 95% policy in force.
	measure 'Cost vs Today' = SUM(service_exchange_curve[vs_current_value])
		formatString: \$#,0
		lineageTag: 02b1b1e0-4015-5971-a140-26ad7ac296db

	/// Every allocation on this page costs the same money. Only where it sits changes.
	measure 'Policy Safety Stock' = SUM(service_policy_options[safety_stock_value])
		formatString: \$#,0
		lineageTag: 499d12a5-0391-53cb-80ad-b6c89493a958

	measure 'Policy Fill Units' = SUM(service_policy_options[fill_units])
		formatString: 0.00%
		lineageTag: 9531cada-0c1b-5df8-bdfa-baac31346693

	measure 'Policy Fill Revenue' = SUM(service_policy_options[fill_revenue])
		formatString: 0.00%
		lineageTag: 1e3d2021-f36b-5e69-91fb-85038c8d5122

	measure 'Value Held Now' = SUM(service_policy_by_class[value_now])
		formatString: \$#,0
		lineageTag: 003503a4-9ef6-5b2c-a36e-ef29981516e3

	/// How the textbook ABC ladder moves money between classes at constant spend.
	measure 'Ladder Change' = SUM(service_policy_by_class[ladder_change])
		formatString: \$#,0
		lineageTag: 3e4f535f-220d-57dd-ba9a-a367b713f5ee

	/// How a marginal-return allocation moves it - which on this network is the opposite direction.
	measure 'Optimal Change' = SUM(service_policy_by_class[optimal_change])
		formatString: \$#,0
		lineageTag: 4919e25e-f6c1-50c4-bd4f-3690d2361a61
