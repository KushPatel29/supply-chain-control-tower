	/// The snapshot every stock figure is read from: the latest weekly snapshot that
	/// is complete, meaning it carries at least 75% of the median snapshot's lots.
	/// The generated data's last three snapshots are thin (171, 142 and 116 lots
	/// against a median of 280, nothing within 61 days of expiry), and reading the very
	/// last one reported $202,393 of stock and 0.0% at risk - the tail of the data, not
	/// the state of the warehouses. The date is judged across the whole inventory, not
	/// inside a row: judged per row, a lot's own last snapshot counted as complete, so
	/// the Jun 4 lot table listed lots last counted in April and the product rows added
	/// to 47,472 units under a total of 51,428. Only the calendar filter is kept.
	measure 'Inventory Snapshot Date' =
			VAR vSnapshots =
			    CALCULATETABLE(
			        ADDCOLUMNS(VALUES(fact_inventory[snapshot_date]), "@lots", CALCULATE(COUNTROWS(fact_inventory))),
			        REMOVEFILTERS(fact_inventory),
			        VALUES(dim_date[full_date])
			    )
			VAR vTypical = MEDIANX(vSnapshots, [@lots])
			VAR vComplete = FILTER(vSnapshots, [@lots] >= 0.75 * vTypical)
			RETURN
			    MAXX(vComplete, fact_inventory[snapshot_date])
		formatString: yyyy-mm-dd
		lineageTag: 2b9ad68e-a89b-5fac-b9cd-90dc0dbd6327
		displayFolder: Inventory Risk

	measure 'Selected Expiry Window Days' = SELECTEDVALUE('Expiry Window'[Days], 5)
		formatString: 0
		lineageTag: dceaf12d-71a0-5968-abfe-b99358b26c6a
		displayFolder: Inventory Risk

	measure 'Expiry Window Label' = "within " & [Selected Expiry Window Days] & " days"
		lineageTag: 886249c5-1afb-57f6-ac4c-16bb1af7bfb8
		displayFolder: Inventory Risk

	/// Stock value in the snapshot that expires inside the selected window.
	measure 'Value Expiring In Window' =
			VAR vAsOfDate = [Inventory Snapshot Date]
			VAR vDays = [Selected Expiry Window Days]
			RETURN
			    CALCULATE(
			        SUM(fact_inventory[inventory_value]),
			        fact_inventory[snapshot_date] = vAsOfDate,
			        fact_inventory[days_until_expiry] <= vDays
			    )
		formatString: \$#,0
		lineageTag: 1070640b-89b0-519d-9a19-acc6a32fecf6
		displayFolder: Inventory Risk

	measure 'Units Expiring In Window' =
			VAR vAsOfDate = [Inventory Snapshot Date]
			VAR vDays = [Selected Expiry Window Days]
			RETURN
			    CALCULATE(
			        SUM(fact_inventory[qty_on_hand]),
			        fact_inventory[snapshot_date] = vAsOfDate,
			        fact_inventory[days_until_expiry] <= vDays
			    )
		formatString: #,0
		lineageTag: d3bf5287-b1be-5393-ad85-a4dabb796bf0
		displayFolder: Inventory Risk

	measure 'Lots Expiring In Window' =
			VAR vAsOfDate = [Inventory Snapshot Date]
			VAR vDays = [Selected Expiry Window Days]
			RETURN
			    CALCULATE(
			        COUNTROWS(fact_inventory),
			        fact_inventory[snapshot_date] = vAsOfDate,
			        fact_inventory[days_until_expiry] <= vDays,
			        fact_inventory[qty_on_hand] > 0
			    )
		formatString: #,0
		lineageTag: 0492902a-e6be-548f-a3e5-35ff324b8165
		displayFolder: Inventory Risk

	measure 'Stocked Lots' =
			VAR vAsOfDate = [Inventory Snapshot Date]
			RETURN
			    CALCULATE(
			        COUNTROWS(fact_inventory),
			        fact_inventory[snapshot_date] = vAsOfDate,
			        fact_inventory[qty_on_hand] > 0
			    )
		formatString: #,0
		lineageTag: 68f7c965-cd35-53e8-9441-4d4f77a13dc4
		displayFolder: Inventory Risk

	measure '% Value Expiring In Window' = DIVIDE(COALESCE([Value Expiring In Window], 0), [Total Inventory Value])
		formatString: 0.0%
		lineageTag: c769a9f7-fecb-55fc-9742-0d7bfbbf1600
		displayFolder: Inventory Risk

	/// Shelf life left in the snapshot, weighted by value: where the money actually sits.
	measure 'Weighted Days To Expiry' =
			VAR vAsOfDate = [Inventory Snapshot Date]
			RETURN
			    DIVIDE(
			        CALCULATE(
			            SUMX(fact_inventory, fact_inventory[inventory_value] * fact_inventory[days_until_expiry]),
			            fact_inventory[snapshot_date] = vAsOfDate
			        ),
			        [Total Inventory Value]
			    )
		formatString: 0.0
		lineageTag: ba9af675-bbcf-5344-9cd0-1196b37c57c3
		displayFolder: Inventory Risk

	measure 'Expiry Window Reference' = FORMAT(COALESCE([% Value Expiring In Window], 0), "0.0%") & " of stock value · " & FORMAT(COALESCE([Units Expiring In Window], 0), "#,0") & " units"
		lineageTag: 25e00e6b-1e5a-5a1f-8d1c-5a9b9ed0c914
		displayFolder: Inventory Risk

	measure 'Lots Expiring Reference' = FORMAT(COALESCE([Lots Expiring In Window], 0), "#,0") & " of " & FORMAT([Stocked Lots], "#,0") & " stocked lots " & [Expiry Window Label]
