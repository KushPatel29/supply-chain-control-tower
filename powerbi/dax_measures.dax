// =====================================================================
// DAX measure library — Supply Chain Control Tower
// Organized as a "measure table" (create a blank table named _Measures
// in Power BI, hide it, and put all of these there — standard governed
// semantic-model practice instead of scattering measures across fact tables).
// =====================================================================

// ---------- Revenue / Margin ----------

Total Revenue = SUM(fact_orders[revenue])

Total COGS = SUM(fact_orders[cogs])

Gross Margin $ = [Total Revenue] - [Total COGS]

Gross Margin % =
DIVIDE([Gross Margin $], [Total Revenue])

// ---------- Fulfillment (OTIF) ----------

Total Orders = DISTINCTCOUNT(fact_orders[order_id])

OTIF Orders =
CALCULATE([Total Orders], fact_orders[otif_flag] = 1)

OTIF % =
DIVIDE([OTIF Orders], [Total Orders])

Avg Fill Rate =
AVERAGE(fact_orders[fill_rate])

Qty Ordered = SUM(fact_orders[qty_ordered])
Qty Shipped = SUM(fact_orders[qty_shipped])

// ---------- Inventory & Expiry Risk ----------

// Stock on hand as of the latest snapshot in the current filter context.
// Stock on hand as of [Inventory Snapshot Date], the latest complete weekly snapshot.
// A plain SUM adds 26 weekly photographs: $34,564,500 against $1,166,666 on Jun 4, 2025.
Total Inventory Value =
VAR vAsOfDate = [Inventory Snapshot Date]
RETURN
    CALCULATE(
        SUM(fact_inventory[inventory_value]),
        fact_inventory[snapshot_date] = vAsOfDate
    )

// The date those stock figures are as of.
Inventory As Of =
[Inventory Snapshot Date]

// The as-of date as text, for the card subtitle on the inventory page.
Inventory As Of Label =
VAR vAsOf = [Inventory As Of]
RETURN
    IF(
        ISBLANK(vAsOf),
        "No stock in scope",
        "Stock as of " & FORMAT(vAsOf, "mmm d, yyyy") & ", last complete snapshot"
    )

// Units on hand as of [Inventory Snapshot Date]: 1,519,002 summed across 26 snapshots
// against 51,428 on Jun 4, 2025.
Qty On Hand =
VAR vAsOfDate = [Inventory Snapshot Date]
RETURN
    CALCULATE(
        SUM(fact_inventory[qty_on_hand]),
        fact_inventory[snapshot_date] = vAsOfDate
    )

Critical Expiry Value =
CALCULATE([Total Inventory Value], fact_inventory[expiry_risk_flag] = "Critical")

Warning Expiry Value =
CALCULATE([Total Inventory Value], fact_inventory[expiry_risk_flag] = "Warning")

% Inventory at Risk =
// "At risk" = anything flagged Critical or Warning by the FEFO calc in 02_silver_transform.py
DIVIDE([Critical Expiry Value] + [Warning Expiry Value], [Total Inventory Value])

// Average inventory value across the snapshot dates in the current filter context.
// Needed as the denominator for turns/days-on-hand — using a plain SUM would double-count
// across multiple weekly snapshots instead of averaging them.
Avg Inventory Value =
AVERAGEX(VALUES(dim_date[full_date]), [Total Inventory Value])

// ---------- Inventory risk: the complete snapshot and the expiry window ----------

// The snapshot every stock figure is read from: the latest weekly snapshot that
// is complete, meaning it carries at least 75% of the median snapshot's lots.
// The generated data's last three snapshots are thin (171, 142 and 116 lots
// against a median of 280, nothing within 61 days of expiry), and reading the very
// last one reported $202,393 of stock and 0.0% at risk - the tail of the data, not
// the state of the warehouses. The date is judged across the whole inventory, not
// inside a row: judged per row, a lot's own last snapshot counted as complete, so
// the Jun 4 lot table listed lots last counted in April and the product rows added
// to 47,472 units under a total of 51,428. Only the calendar filter is kept.
Inventory Snapshot Date =
VAR vSnapshots =
    CALCULATETABLE(
        ADDCOLUMNS(VALUES(fact_inventory[snapshot_date]), "@lots", CALCULATE(COUNTROWS(fact_inventory))),
        REMOVEFILTERS(fact_inventory),
        VALUES(dim_date[full_date])
    )
VAR vTypical = MEDIANX(vSnapshots, [@lots])
VAR vComplete = FILTER(vSnapshots, [@lots] >= 0.75 * vTypical)
RETURN
    MAXX(vComplete, fact_inventory[snapshot_date])

Selected Expiry Window Days =
SELECTEDVALUE('Expiry Window'[Days], 5)

Expiry Window Label =
"within " & [Selected Expiry Window Days] & " days"

// Stock value in the snapshot that expires inside the selected window.
Value Expiring In Window =
VAR vAsOfDate = [Inventory Snapshot Date]
VAR vDays = [Selected Expiry Window Days]
RETURN
    CALCULATE(
        SUM(fact_inventory[inventory_value]),
        fact_inventory[snapshot_date] = vAsOfDate,
        fact_inventory[days_until_expiry] <= vDays
    )

Units Expiring In Window =
VAR vAsOfDate = [Inventory Snapshot Date]
VAR vDays = [Selected Expiry Window Days]
RETURN
    CALCULATE(
        SUM(fact_inventory[qty_on_hand]),
        fact_inventory[snapshot_date] = vAsOfDate,
        fact_inventory[days_until_expiry] <= vDays
    )

Lots Expiring In Window =
VAR vAsOfDate = [Inventory Snapshot Date]
VAR vDays = [Selected Expiry Window Days]
RETURN
    CALCULATE(
        COUNTROWS(fact_inventory),
        fact_inventory[snapshot_date] = vAsOfDate,
        fact_inventory[days_until_expiry] <= vDays,
        fact_inventory[qty_on_hand] > 0
    )

Stocked Lots =
VAR vAsOfDate = [Inventory Snapshot Date]
RETURN
    CALCULATE(
        COUNTROWS(fact_inventory),
        fact_inventory[snapshot_date] = vAsOfDate,
        fact_inventory[qty_on_hand] > 0
    )

% Value Expiring In Window =
DIVIDE(COALESCE([Value Expiring In Window], 0), [Total Inventory Value])

// Shelf life left in the snapshot, weighted by value: where the money actually sits.
Weighted Days To Expiry =
VAR vAsOfDate = [Inventory Snapshot Date]
RETURN
    DIVIDE(
        CALCULATE(
            SUMX(fact_inventory, fact_inventory[inventory_value] * fact_inventory[days_until_expiry]),
            fact_inventory[snapshot_date] = vAsOfDate
        ),
        [Total Inventory Value]
    )

Expiry Window Reference =
FORMAT(COALESCE([% Value Expiring In Window], 0), "0.0%") & " of stock value · " & FORMAT(COALESCE([Units Expiring In Window], 0), "#,0") & " units"

Lots Expiring Reference =
FORMAT(COALESCE([Lots Expiring In Window], 0), "#,0") & " of " & FORMAT([Stocked Lots], "#,0") & " stocked lots " & [Expiry Window Label]

Shelf Life Reference =
"Days on hand " & FORMAT([Days On Hand], "0.0") & " · turns " & FORMAT([Inventory Turns], "0.0")

Warehouse Expiry Chart Title =
"Value expiring " & [Expiry Window Label] & ", by warehouse"

// Annualized inventory turns: how many times inventory is sold through per year.
// Standard formula = COGS / Average Inventory Value, scaled to the period in filter context.
Inventory Turns =
VAR DaysInPeriod = DATEDIFF(MIN(dim_date[full_date]), MAX(dim_date[full_date]), DAY) + 1
VAR AnnualizationFactor = DIVIDE(365, DaysInPeriod)
RETURN
    DIVIDE([Total COGS], [Avg Inventory Value]) * AnnualizationFactor

Days On Hand =
DIVIDE(365, [Inventory Turns])

// ---------- Row counts for QA / DQ dashboard tie-in ----------

DQ Checks Passed =
CALCULATE(COUNTROWS(dq_log), dq_log[passed] = TRUE)

DQ Checks Total = COUNTROWS(dq_log)

DQ Pass Rate = DIVIDE([DQ Checks Passed], [DQ Checks Total])
